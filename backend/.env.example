# 复制本文件为 backend/.env 并填写真实值
# 注意：backend/.env 已被 .gitignore 忽略，不会进入仓库；本模板仅供参照

# JWT 签名密钥：至少 32 位，泄露即可伪造任意用户（含管理员）身份
# 生成命令：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# 初始管理员密码：至少 8 位
# 首次启动且 users 表为空时自动创建 admin 账号；留空则不创建任何管理员
# （可稍后通过注册接口创建，再把角色改为 admin）
ADMIN_PASSWORD=

# 服务端口
PORT=3000
